# Data files (Large generated data files)
data/raw/
data/processed/

# Prevent ignoring critical root files like package.json, requirements.txt, by targeting specific data formats explicitly within the data directory instead of globally
data/**/*.csv
data/**/*.json
data/**/*.pdf
data/**/*.txt
data/**/*.docx

# Keeps the data folder structure in place
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

