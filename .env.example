# HR & Compliance RAG System - Environment Variables
# Copy this file to .env and update with your values

# Data paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
METADATA_FILE=data/metadata.csv

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Document validation
MIN_DOC_LENGTH=10

# Week 2: Embedding & Vector DB settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
BATCH_SIZE=32
FAISS_INDEX_TYPE=flat

# Week 3: Groq LLM settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Week 3: RAG settings
RAG_TOP_K=5

# API settings
API_HOST=localhost
API_PORT=8000
